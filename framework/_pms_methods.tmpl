    if-nez p1, :cancel
    iget-boolean v0, p0, {PMS}->mInkpalmPending:Z
    if-eqz v0, :cancel
    iget-boolean v0, p0, {PMS}->mInkpalmIsTimeout:Z
    if-nez v0, :cancel
    const-string v0, "InkpalmStandby"
    const-string v1, "preserved power-button request after software NO_CHANGE_LIGHTS activity"
    new-instance v2, Ljava/lang/Throwable;
    invoke-direct {{v2}}, Ljava/lang/Throwable;-><init>()V
    invoke-static {{v0, v1, v2}}, Landroid/util/Log;->i(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
    return-void
    :cancel
    invoke-direct {{p0}}, {PMS}->inkpalmInvalidate()V
    return-void
.end method
