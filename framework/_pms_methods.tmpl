
# inkpalm: promote the staged request to the pending one and arm a delayed sleep.
#
# No arguments ON PURPOSE. Most Dalvik instructions address only v0-v15, so a method with many
# parameters pushes them past that limit, and raising an EXISTING method's .locals shifts its
# parameter registers up and breaks instructions that were already there (this is not
# hypothetical -- the first attempt at this failed to assemble for exactly that reason).
# Callers therefore stage the request in fields using the registers they already hold, and
# call this with a single register.
#
# Coalescing policy, explicit because it is a choice and not a fallout:
#   pending timeout + new timeout  -> ignore. updateWakefulnessLocked re-runs constantly while
#                                     awake; without this it would re-arm forever, never sleep.
#   pending timeout + new button   -> SUPERSEDE. The user pressed power; that request's event
#                                     time and flags are the ones to honour.
#   pending button  + anything     -> ignore. The explicit request in flight wins.
.method private inkpalmArm()V
    .registers 8

    iget-object v0, p0, {PMS}->mLock:Ljava/lang/Object;

    monitor-enter v0

    :try_start_0
    iget-boolean v1, p0, {PMS}->mInkpalmPending:Z

    if-eqz v1, :cond_arm

    iget-boolean v1, p0, {PMS}->mInkpalmReqTimeout:Z

    if-nez v1, :cond_done

    iget-boolean v1, p0, {PMS}->mInkpalmIsTimeout:Z

    if-eqz v1, :cond_done

    :cond_arm
    iget-wide v1, p0, {PMS}->mInkpalmReqTime:J

    iput-wide v1, p0, {PMS}->mInkpalmEventTime:J

    iget v1, p0, {PMS}->mInkpalmReqReason:I

    iput v1, p0, {PMS}->mInkpalmReason:I

    iget v1, p0, {PMS}->mInkpalmReqFlags:I

    iput v1, p0, {PMS}->mInkpalmFlags:I

    iget v1, p0, {PMS}->mInkpalmReqUid:I

    iput v1, p0, {PMS}->mInkpalmUid:I

    iget-boolean v1, p0, {PMS}->mInkpalmReqTimeout:Z

    iput-boolean v1, p0, {PMS}->mInkpalmIsTimeout:Z

    iget v1, p0, {PMS}->mInkpalmGen:I

    add-int/lit8 v1, v1, 0x1

    iput v1, p0, {PMS}->mInkpalmGen:I

    const/4 v2, 0x1

    iput-boolean v2, p0, {PMS}->mInkpalmPending:Z

    iget-object v3, p0, {PMS}->mHandler:Landroid/os/Handler;

    new-instance v2, {KEYGUARD}

    invoke-direct {{v2, p0}}, {KEYGUARD}-><init>({PMS})V

    invoke-virtual {{v3, v2}}, Landroid/os/Handler;->post(Ljava/lang/Runnable;)Z

    new-instance v2, {SLEEPER}

    invoke-direct {{v2, p0, v1}}, {SLEEPER}-><init>({PMS}I)V

    const-wide/16 v4, 0x320

    invoke-virtual {{v3, v2, v4, v5}}, Landroid/os/Handler;->postDelayed(Ljava/lang/Runnable;J)Z

    move-result v1

    if-nez v1, :cond_done

    # The looper refused the message (it is exiting). Leaving mInkpalmPending set would
    # suppress every later sleep, so drop the request and do what stock would have done.
    const/4 v1, 0x0

    iput-boolean v1, p0, {PMS}->mInkpalmPending:Z

    iget v1, p0, {PMS}->mInkpalmGen:I

    add-int/lit8 v1, v1, 0x1

    iput v1, p0, {PMS}->mInkpalmGen:I

    move-object v1, p0

    iget-wide v2, p0, {PMS}->mInkpalmEventTime:J

    iget v4, p0, {PMS}->mInkpalmReason:I

    iget v5, p0, {PMS}->mInkpalmFlags:I

    iget v6, p0, {PMS}->mInkpalmUid:I

    invoke-direct/range {{v1 .. v6}}, {PMS}->goToSleepNoUpdateLocked(JIII)Z

    move-result v1

    if-eqz v1, :cond_done

    invoke-direct {{p0}}, {PMS}->updatePowerStateLocked()V

    :cond_done
    monitor-exit v0
    :try_end_0
    .catchall {{:try_start_0 .. :try_end_0}} :catchall_0

    return-void

    :catchall_0
    move-exception v1

    monitor-exit v0

    throw v1
.end method

# inkpalm: the delayed callback. Token check, eligibility re-check and the sleep all happen in
# ONE acquisition of mLock, so nothing can interleave between deciding and sleeping.
.method inkpalmFire(I)V
    .registers 14

    iget-object v0, p0, {PMS}->mLock:Ljava/lang/Object;

    monitor-enter v0

    :try_start_0
    iget v1, p0, {PMS}->mInkpalmGen:I

    if-ne v1, p1, :cond_done

    const/4 v1, 0x0

    iput-boolean v1, p0, {PMS}->mInkpalmPending:Z

    # A timeout request must still be warranted when it fires. A wake lock taken during the
    # delay, or a changed screen-off timeout, generates no user activity at all, so the token
    # does not cover it. A power-button request is unconditional, as in stock.
    iget-boolean v1, p0, {PMS}->mInkpalmIsTimeout:Z

    if-eqz v1, :cond_go

    invoke-direct {{p0}}, {PMS}->isItBedTimeYetLocked()Z

    move-result v1

    if-eqz v1, :cond_done

    :cond_go
    # the ORIGINAL event time, reason, flags and uid, so goToSleepNoUpdateLocked's own
    # staleness checks (against mLastWakeTime / mLastSleepTime) still reject a request that a
    # wake overtook. Substituting "now" and zero flags would quietly change that.
    move-object v2, p0

    iget-wide v3, p0, {PMS}->mInkpalmEventTime:J

    iget v5, p0, {PMS}->mInkpalmReason:I

    iget v6, p0, {PMS}->mInkpalmFlags:I

    iget v7, p0, {PMS}->mInkpalmUid:I

    invoke-direct/range {{v2 .. v7}}, {PMS}->goToSleepNoUpdateLocked(JIII)Z

    move-result v1

    if-eqz v1, :cond_done

    invoke-direct {{p0}}, {PMS}->updatePowerStateLocked()V

    :cond_done
    monitor-exit v0
    :try_end_0
    .catchall {{:try_start_0 .. :try_end_0}} :catchall_0

    return-void

    :catchall_0
    move-exception v1

    monitor-exit v0

    throw v1
.end method

# inkpalm: show the keyguard from the handler thread. The policy reference is read under the
# lock and lockNow() is called AFTER releasing it: it reaches window manager over binder, and
# stock PowerManagerService never invokes WindowManagerPolicy itself -- it hands the policy to
# Notifier, which calls it from its own thread. Holding mLock across that is a lock-order hazard.
.method public inkpalmShowKeyguard()V
    .registers 4

    iget-object v0, p0, {PMS}->mLock:Ljava/lang/Object;

    monitor-enter v0

    :try_start_0
    iget-object v1, p0, {PMS}->mPolicy:Lcom/android/server/policy/WindowManagerPolicy;

    monitor-exit v0
    :try_end_0
    .catchall {{:try_start_0 .. :try_end_0}} :catchall_0

    if-eqz v1, :cond_none

    const/4 v2, 0x0

    invoke-interface {{v1, v2}}, Lcom/android/server/policy/WindowManagerPolicy;->lockNow(Landroid/os/Bundle;)V

    :cond_none
    return-void

    :catchall_0
    move-exception v1

    monitor-exit v0

    throw v1
.end method

# inkpalm: accepted user activity invalidates any pending delayed sleep. Called from
# userActivityNoUpdateLocked (lock already held) at the points where it records the activity.
.method private inkpalmInvalidate()V
    .registers 2

    iget v0, p0, {PMS}->mInkpalmGen:I

    add-int/lit8 v0, v0, 0x1

    iput v0, p0, {PMS}->mInkpalmGen:I

    const/4 v0, 0x0

    iput-boolean v0, p0, {PMS}->mInkpalmPending:Z

    return-void
.end method
