<?xml version="1.0" encoding="utf-8"?>
<!-- Stock brightness row, plus a labelled front-light warmth row underneath.
     The original ToggleSliderView keeps its id, size and weight; nothing here declares a new
     android:id, so SystemUI's resource table is unchanged and QSPanel needs no patch.
     "Brightness" reuses the existing localised SystemUI string; the other labels are literals
     (this port is English-only, see docs/FRONTLIGHT.md).
     Both rows use the same 8dp side padding and the same 52dp end-label width, so the two
     slider tracks line up and nothing sits against the panel edge. -->
<LinearLayout android:orientation="vertical" android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BrightnessDialogContainer"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:systemui="http://schemas.android.com/apk/res-auto">

    <TextView android:text="@string/quick_settings_brightness_label" android:textColor="?android:attr/textColorPrimary" android:textSize="14.0sp" android:paddingStart="12.0dp" android:paddingTop="4.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8.0dp" android:paddingEnd="8.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="-" android:textColor="?android:attr/textColorPrimary" android:textSize="18.0sp" android:gravity="center" android:minWidth="52.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.android.systemui.settings.ToggleSliderView android:layout_gravity="center_vertical" android:id="@id/brightness_slider" android:layout_width="0.0dp" android:layout_height="48.0dp" android:layout_weight="1.0" android:contentDescription="@string/accessibility_brightness" android:importantForAccessibility="no" systemui:text="@string/status_bar_settings_auto_brightness_label" />
        <TextView android:text="+" android:textColor="?android:attr/textColorPrimary" android:textSize="18.0sp" android:gravity="center" android:minWidth="52.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:text="Screen Temperature" android:textColor="?android:attr/textColorPrimary" android:textSize="14.0sp" android:paddingStart="12.0dp" android:paddingTop="6.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8.0dp" android:paddingEnd="8.0dp" android:paddingBottom="4.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Cool" android:textColor="?android:attr/textColorPrimary" android:textSize="13.0sp" android:gravity="center" android:minWidth="52.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.android.systemui.inkpalm.WarmthSliderView android:layout_gravity="center_vertical" android:layout_width="0.0dp" android:layout_height="48.0dp" android:layout_weight="1.0" android:contentDescription="Front light warmth" />
        <TextView android:text="Warm" android:textColor="?android:attr/textColorPrimary" android:textSize="13.0sp" android:gravity="center" android:minWidth="52.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
